{
  "name": "jev-claude-router",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test 'tests/*.test.ts'",
    "typecheck": "tsc -p .",
    "types": "mkdir -p .claude/types && curl -sSL -o .claude/types/claude-code.d.ts https://raw.githubusercontent.com/anthropics/claude-code/56f36532530f88b572854538d685fcf781141e8c/mods/types/claude-code.d.ts",
    "validate": "claude plugin validate .",
    "check": "npm run typecheck && npm test && npm run validate",
    "check-jev": "node --experimental-strip-types scripts/check-jev.mjs",
    "check-gateway": "node --experimental-strip-types scripts/check-jev.mjs",
    "try-prompts": "node --experimental-strip-types scripts/try-prompts.mjs",
    "measure-switch-cost": "node --experimental-strip-types scripts/measure-switch-cost.mjs",
    "bench-overhead": "node --experimental-strip-types scripts/bench-overhead.ts"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "license": "MIT"
}
